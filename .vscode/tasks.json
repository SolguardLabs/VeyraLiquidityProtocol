{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Forge: build",
      "type": "shell",
      "command": "forge build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Forge: test",
      "type": "shell",
      "command": "forge test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Forge: format check",
      "type": "shell",
      "command": "forge fmt --check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Veyra: CI local",
      "type": "shell",
      "command": "bash scripts/ci.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

